---
layout: layouts/base.njk
ogType: article
showProgress: true
showFieldNotesNav: true
headerMark: "NK / Field Notes"
headerHomeHref: "/writeups/"
footerBackHref: "/writeups/"
footerBackLabel: "← Back to field notes"
extraStyles:
  - /css/article.css
---

<main>
  <article class="container">

    <header class="article-header prose">
      {% if kicker %}<p class="article-kicker">{{ kicker }}</p>{% endif %}
      <h1 class="article-title">{{ articleTitle or title }}</h1>
      {% if dek %}<p class="article-dek">{{ dek }}</p>{% endif %}
      <div class="article-meta">
        {% if tag %}<span class="tag">{{ tag }}</span><span class="sep"></span>{% endif %}
        {% if type %}<span>{{ type }}</span><span class="sep"></span>{% endif %}
        <span>{{ date | longDate }}</span>
        <span class="sep"></span><span>{{ readtime or (content | readtime) }}</span>
      </div>
    </header>

    <div class="body prose">
      {{ content | safe }}

      {% if site.author.kofi %}
      <a href="{{ site.author.kofi }}" target="_blank" rel="noopener" class="support-card">
        <span class="support-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
            <line x1="6" y1="1" x2="6" y2="4"/>
            <line x1="10" y1="1" x2="10" y2="4"/>
            <line x1="14" y1="1" x2="14" y2="4"/>
          </svg>
        </span>
        <span class="support-text">
          <span class="support-kicker">Support these write-ups</span>
          <span class="support-title">If this was useful, you can buy me a coffee on Ko-fi</span>
        </span>
        <span class="support-arrow" aria-hidden="true">↗</span>
      </a>
      {% endif %}
    </div>

  </article>
</main>

<script>
(function() {
  var progress = document.getElementById('progress');
  function updateProgress() {
    var h = document.documentElement;
    var scrolled = h.scrollTop;
    var height = h.scrollHeight - h.clientHeight;
    var pct = height > 0 ? (scrolled / height) * 100 : 0;
    if (progress) progress.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  var finding = document.getElementById('finding');
  var revealBtn = document.getElementById('findingReveal');
  var answer = document.getElementById('findingAnswer');
  if (revealBtn && finding) {
    revealBtn.addEventListener('click', function() {
      finding.classList.add('revealed');
      revealBtn.setAttribute('aria-expanded', 'true');
      if (answer) answer.setAttribute('aria-hidden', 'false');
    });
  }
})();
</script>
